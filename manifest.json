{
  "manifest_version": 3,
  "name": "Focus Garden",
  "version": "0.1.0",
  "description": "Grows a plant whose shape is a record of how you focused.",
  "permissions": ["tabs", "storage", "alarms", "idle"],
  "action": {
    "default_title": "Focus Garden",
    "default_popup": "pages/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
